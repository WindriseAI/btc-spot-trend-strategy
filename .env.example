# 复制本文件为 .env 再填写。.env 已被 git 忽略，不要把它发给任何人、不要贴到聊天里。

# —— 模拟盘（欧易「模拟交易」里创建的 API key）——
OKX_DEMO_API_KEY=
OKX_DEMO_API_SECRET=
OKX_DEMO_API_PASSPHRASE=

# —— 实盘（只勾选「读取」和「交易」，绝对不要勾「提现」；建议绑定 IP）——
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=

# 实盘下单的总开关：只有写成 yes，`python -m btc live` 才会运行
LIVE_CONFIRM=

# —— 以下一般不用改 ——
# 状态文件目录（必须是不会被清空的持久目录）
# STATE_DIR=./state
# 单笔滑点上限（默认 0.003 = 0.3%，最大 0.004）
# SLIPPAGE_CAP=0.003
# 两个行情源最新收盘价允许的最大差异（默认 0.015 = 1.5%）
# MAX_SOURCE_DIFF=0.015
# 现货吃单手续费率，小数形式（默认 0.001 = 0.1%；请在欧易的「手续费率」页面核对，有的地区是 0.002 或 0.0035）
# 程序连上账户后会优先读取交易所返回的实际费率，这里是读不到时的备用值，也用于影子账
# SPOT_FEE=0.001
# 单笔订单金额上限，USDT（默认不限）
# MAX_ORDER_USDT=
# 访问欧易需要代理时填写，例如 http://127.0.0.1:7890
# OKX_PROXY=
# 欧易 API 域名（默认 www.okx.com）
# OKX_HOSTNAME=www.okx.com
# 欧易 AI Builder Code（可选，仅 1~16 位英文字母或数字；设置后会作为订单 tag 提交，不增加用户手续费）
# OKX_AI_BUILDER_CODE=
